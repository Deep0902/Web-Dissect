{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Web Dissect 🔍🕸️",
  "short_name": "Web Dissect",
  "description": "Scan any webpage for accessibility issues with axe-core. Detect WCAG violations and get instant audit reports.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "96": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Opens Popup",
      "global": true
    },
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open the side panel"
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "96": "icon.png"
    },
    "default_title": "Web Dissect \u2014 Accessibility Scanner"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
